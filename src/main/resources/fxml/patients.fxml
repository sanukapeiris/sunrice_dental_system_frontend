<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sunrise.dental.frontend.controller.PatientController"
            styleClass="dashboard">

    <top>

        <VBox spacing="5">

            <padding>
                <Insets top="20" right="25" bottom="15" left="25"/>
            </padding>

            <Label text="SUNRISE DENTAL CLINIC"
                   styleClass="dashboard-title"/>

            <Label text="Patient Management"
                   styleClass="dashboard-heading"/>

        </VBox>

    </top>

    <center>

        <VBox spacing="15">

            <padding>
                <Insets top="10" right="25" bottom="20" left="25"/>
            </padding>

            <GridPane hgap="10" vgap="10">

                <Label text="Name:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="nameField"
                           promptText="Patient name"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Address:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="addressField"
                           promptText="Patient address"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <Label text="Contact:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="contactField"
                           promptText="Contact number"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

            </GridPane>

            <HBox spacing="10">

                <Button text="ADD PATIENT"
                        onAction="#addPatient"
                        styleClass="dashboard-button-small"/>

                <Button text="UPDATE"
                        onAction="#updatePatient"
                        styleClass="dashboard-button-small"/>

                <Button text="DELETE"
                        onAction="#deletePatient"
                        styleClass="dashboard-button-small"/>

                <Button text="CLEAR"
                        onAction="#clearFields"
                        styleClass="dashboard-button-small"/>

                <Button text="REFRESH"
                        onAction="#loadPatients"
                        styleClass="dashboard-button-small"/>

            </HBox>

            <Label fx:id="messageLabel"
                   text=""
                   styleClass="message"/>

            <TableView fx:id="patientTable"
                       prefHeight="350">

                <columns>

                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="70"/>

                    <TableColumn fx:id="nameColumn"
                                 text="Name"
                                 prefWidth="180"/>

                    <TableColumn fx:id="addressColumn"
                                 text="Address"
                                 prefWidth="220"/>

                    <TableColumn fx:id="contactColumn"
                                 text="Contact Number"
                                 prefWidth="160"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>