<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sunrise.dental.frontend.controller.PatientController">

    <!-- ================= HEADER ================= -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="20"
              styleClass="page-header">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="20"
                        left="25"/>
            </padding>

            <Button text="← Back to Dashboard"
                    onAction="#goBack"
                    styleClass="back-button"/>

            <VBox spacing="3">

                <Label text="Patient Management"
                       styleClass="page-title"/>

                <Label text="Register and manage clinic patients"
                       styleClass="page-subtitle"/>

            </VBox>

        </HBox>

    </top>


    <!-- ================= MAIN CONTENT ================= -->

    <center>

        <VBox spacing="18">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="20"
                        left="25"/>
            </padding>


            <!-- ================= PATIENT FORM ================= -->

            <GridPane hgap="15"
                      vgap="12">

                <Label text="Patient Name:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="nameField"
                           promptText="Enter patient name"
                           prefWidth="350"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>


                <Label text="Address:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="addressField"
                           promptText="Enter patient address"
                           prefWidth="350"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>


                <Label text="Contact Number:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="contactField"
                           promptText="Enter 10 digit contact number"
                           prefWidth="350"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

            </GridPane>


            <!-- ================= BUTTONS ================= -->

            <HBox spacing="12"
                  alignment="CENTER_LEFT">

                <Button text="ADD PATIENT"
                        onAction="#addPatient"
                        styleClass="action-button"/>

                <Button text="UPDATE"
                        onAction="#updatePatient"
                        styleClass="action-button"/>

                <Button text="DELETE"
                        onAction="#deletePatient"
                        styleClass="action-button"/>

                <Button text="CLEAR"
                        onAction="#clearFields"
                        styleClass="action-button"/>

                <Button text="REFRESH"
                        onAction="#loadPatients"
                        styleClass="action-button"/>

            </HBox>


            <!-- ================= MESSAGE ================= -->

            <Label fx:id="messageLabel"
                   text=""
                   styleClass="message-label"/>


            <!-- ================= PATIENT TABLE ================= -->

            <TableView fx:id="patientTable"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="70"/>

                    <TableColumn fx:id="nameColumn"
                                 text="Patient Name"
                                 prefWidth="200"/>

                    <TableColumn fx:id="addressColumn"
                                 text="Address"
                                 prefWidth="300"/>

                    <TableColumn fx:id="contactColumn"
                                 text="Contact Number"
                                 prefWidth="180"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>