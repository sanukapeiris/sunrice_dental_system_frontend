<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sunrise.dental.frontend.controller.DentistController">

    <!-- HEADER -->
    <top>
        <VBox spacing="10"
              styleClass="page-header">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="20"
                        left="25"/>
            </padding>

            <HBox spacing="15"
                  alignment="CENTER_LEFT">

                <Button text="← Back to Dashboard"
                        onAction="#goBack"
                        styleClass="back-button"/>

                <VBox spacing="3">
                    <Label text="Dentist Management"
                           styleClass="page-title"/>

                    <Label text="Manage clinic dentists"
                           styleClass="page-subtitle"/>
                </VBox>

            </HBox>

        </VBox>
    </top>


    <!-- MAIN CONTENT -->
    <center>

        <VBox spacing="15">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="20"
                        left="25"/>
            </padding>


            <!-- FORM -->
            <GridPane hgap="15"
                      vgap="12">

                <Label text="Dentist Name:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="nameField"
                           promptText="Enter dentist name"
                           prefWidth="300"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>


                <Label text="Specialization:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="specializationField"
                           promptText="Enter specialization"
                           prefWidth="300"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>


                <Label text="Contact Number:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="contactField"
                           promptText="Enter 10 digit contact number"
                           prefWidth="300"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>


                <Label text="Status:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>

                <CheckBox fx:id="activeCheckBox"
                          text="Active Dentist"
                          selected="true"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="3"/>

            </GridPane>


            <!-- ACTION BUTTONS -->
            <HBox spacing="10">

                <Button text="ADD DENTIST"
                        onAction="#addDentist"
                        styleClass="action-button"/>

                <Button text="UPDATE"
                        onAction="#updateDentist"
                        styleClass="action-button"/>

                <Button text="DELETE"
                        onAction="#deleteDentist"
                        styleClass="action-button"/>

                <Button text="CLEAR"
                        onAction="#clearFields"
                        styleClass="action-button"/>

                <Button text="REFRESH"
                        onAction="#loadDentists"
                        styleClass="action-button"/>

            </HBox>


            <Label fx:id="messageLabel"
                   styleClass="message-label"/>


            <!-- TABLE -->
            <TableView fx:id="dentistTable"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="60"/>

                    <TableColumn fx:id="nameColumn"
                                 text="Dentist Name"
                                 prefWidth="200"/>

                    <TableColumn fx:id="specializationColumn"
                                 text="Specialization"
                                 prefWidth="200"/>

                    <TableColumn fx:id="contactColumn"
                                 text="Contact Number"
                                 prefWidth="160"/>

                    <TableColumn fx:id="activeColumn"
                                 text="Active"
                                 prefWidth="100"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>