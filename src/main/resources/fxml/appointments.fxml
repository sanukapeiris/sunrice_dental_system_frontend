<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sunrise.dental.frontend.controller.AppointmentController">

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="20"
              styleClass="page-header">

            <padding>
                <Insets top="20" right="25"
                        bottom="20" left="25"/>
            </padding>

            <Button text="← Back to Dashboard"
                    onAction="#goBack"
                    styleClass="back-button"/>

            <VBox spacing="3">

                <Label text="Appointment Management"
                       styleClass="page-title"/>

                <Label text="Register and manage patient appointments"
                       styleClass="page-subtitle"/>

            </VBox>

        </HBox>

    </top>

    <center>

        <VBox spacing="15">

            <padding>
                <Insets top="20" right="25"
                        bottom="20" left="25"/>
            </padding>

            <GridPane hgap="15"
                      vgap="12">

                <Label text="Patient ID:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="patientIdField"
                           promptText="Patient ID"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Dentist ID:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="dentistIdField"
                           promptText="Dentist ID"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <Label text="Treatment ID:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="treatmentIdField"
                           promptText="Treatment ID"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                <Label text="Date:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>

                <TextField fx:id="dateField"
                           promptText="YYYY-MM-DD"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="3"/>

                <Label text="Time:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="4"/>

                <TextField fx:id="timeField"
                           promptText="HH:MM"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="4"/>

            </GridPane>

            <HBox spacing="10">

                <Button text="REGISTER APPOINTMENT"
                        onAction="#createAppointment"
                        styleClass="action-button"/>

                <Button text="SEARCH"
                        onAction="#searchAppointment"
                        styleClass="action-button"/>

                <Button text="CANCEL APPOINTMENT"
                        onAction="#cancelAppointment"
                        styleClass="action-button"/>

                <Button text="REFRESH"
                        onAction="#loadAppointments"
                        styleClass="action-button"/>

                <Button text="CLEAR"
                        onAction="#clearFields"
                        styleClass="action-button"/>

            </HBox>

            <Label fx:id="messageLabel"
                   styleClass="message-label"/>

            <TableView fx:id="appointmentTable"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="numberColumn"
                                 text="Appointment No."
                                 prefWidth="170"/>

                    <TableColumn fx:id="patientColumn"
                                 text="Patient ID"
                                 prefWidth="100"/>

                    <TableColumn fx:id="dentistColumn"
                                 text="Dentist ID"
                                 prefWidth="100"/>

                    <TableColumn fx:id="treatmentColumn"
                                 text="Treatment ID"
                                 prefWidth="110"/>

                    <TableColumn fx:id="dateColumn"
                                 text="Date"
                                 prefWidth="120"/>

                    <TableColumn fx:id="timeColumn"
                                 text="Time"
                                 prefWidth="100"/>

                    <TableColumn fx:id="statusColumn"
                                 text="Status"
                                 prefWidth="120"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>