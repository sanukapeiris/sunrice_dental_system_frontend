<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.sunrise.dental.frontend.controller.ReportController">

    <top>

        <VBox spacing="8">

            <padding>
                <Insets
                        top="20"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <Label
                    text="REPORTS &amp; DASHBOARD"
                    styleClass="page-title"/>

            <Label
                    text="Sunrise Dental Clinic management summary"
                    styleClass="page-subtitle"/>

        </VBox>

    </top>

    <center>

        <VBox
                spacing="25"
                alignment="CENTER"
                styleClass="report-container">

            <GridPane
                    hgap="20"
                    vgap="20"
                    alignment="CENTER">

                <!-- PATIENTS -->

                <VBox
                        prefWidth="250"
                        prefHeight="150"
                        alignment="CENTER"
                        spacing="10"
                        styleClass="report-card"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="0">

                    <Label
                            text="TOTAL PATIENTS"
                            styleClass="report-card-title"/>

                    <Label
                            fx:id="patientsCountLabel"
                            text="0"
                            styleClass="report-number"/>

                </VBox>


                <!-- DENTISTS -->

                <VBox
                        prefWidth="250"
                        prefHeight="150"
                        alignment="CENTER"
                        spacing="10"
                        styleClass="report-card"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="0">

                    <Label
                            text="TOTAL DENTISTS"
                            styleClass="report-card-title"/>

                    <Label
                            fx:id="dentistsCountLabel"
                            text="0"
                            styleClass="report-number"/>

                </VBox>


                <!-- APPOINTMENTS -->

                <VBox
                        prefWidth="250"
                        prefHeight="150"
                        alignment="CENTER"
                        spacing="10"
                        styleClass="report-card"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="1">

                    <Label
                            text="TOTAL APPOINTMENTS"
                            styleClass="report-card-title"/>

                    <Label
                            fx:id="appointmentsCountLabel"
                            text="0"
                            styleClass="report-number"/>

                </VBox>


                <!-- BILLS -->

                <VBox
                        prefWidth="250"
                        prefHeight="150"
                        alignment="CENTER"
                        spacing="10"
                        styleClass="report-card"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="1">

                    <Label
                            text="TOTAL BILLS"
                            styleClass="report-card-title"/>

                    <Label
                            fx:id="billsCountLabel"
                            text="0"
                            styleClass="report-number"/>

                </VBox>

            </GridPane>


            <Label
                    fx:id="messageLabel"
                    text=""
                    styleClass="message-label"/>


            <HBox
                    spacing="15"
                    alignment="CENTER">

                <Button
                        text="REFRESH REPORT"
                        onAction="#refreshReport"
                        styleClass="primary-button"/>

            </HBox>

        </VBox>

    </center>

    <bottom>

        <HBox alignment="CENTER_LEFT">

            <padding>
                <Insets
                        top="10"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <Button
                    text="← BACK TO DASHBOARD"
                    onAction="#goBack"
                    styleClass="back-button"/>

        </HBox>

    </bottom>

</BorderPane>