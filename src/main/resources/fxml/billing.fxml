<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.sunrise.dental.frontend.controller.BillingController">

    <top>
        <VBox spacing="8">
            <padding>
                <Insets top="20" right="20" bottom="15" left="20"/>
            </padding>

            <Label
                    text="BILLING &amp; RECEIPTS"
                    styleClass="page-title"/>

            <Label
                    text="Generate, search and print patient bills"
                    styleClass="page-subtitle"/>
        </VBox>
    </top>

    <center>

        <HBox
                spacing="30"
                alignment="TOP_CENTER">

            <padding>
                <Insets top="10" right="25" bottom="20" left="25"/>
            </padding>

            <!-- LEFT SIDE -->
            <VBox
                    spacing="15"
                    prefWidth="430"
                    styleClass="card">

                <Label
                        text="Bill Details"
                        styleClass="section-title"/>

                <GridPane
                        hgap="10"
                        vgap="12">

                    <Label
                            text="Appointment Number:"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0"/>

                    <TextField
                            fx:id="appointmentNumberField"
                            promptText="Example: APT-2026-00001"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0"/>

                    <Button
                            text="GENERATE BILL"
                            onAction="#generateBill"
                            styleClass="primary-button"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"/>

                    <Separator
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="2"
                            GridPane.columnSpan="2"/>

                    <Label
                            text="Bill Number:"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="3"/>

                    <TextField
                            fx:id="billNumberField"
                            promptText="Example: BILL-123456"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="3"/>

                    <Button
                            text="SEARCH BILL"
                            onAction="#searchBill"
                            styleClass="secondary-button"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="4"/>

                </GridPane>

                <Separator/>

                <Label
                        text="Cost Summary"
                        styleClass="section-title"/>

                <GridPane
                        hgap="20"
                        vgap="15">

                    <Label
                            text="Treatment Cost:"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0"/>

                    <Label
                            fx:id="treatmentCostLabel"
                            text="Rs. 0.00"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0"/>

                    <Label
                            text="Consultation Fee:"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="1"/>

                    <Label
                            fx:id="consultationFeeLabel"
                            text="Rs. 0.00"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"/>

                    <Separator
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="2"
                            GridPane.columnSpan="2"/>

                    <Label
                            text="TOTAL:"
                            styleClass="total-label"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="3"/>

                    <Label
                            fx:id="totalAmountLabel"
                            text="Rs. 0.00"
                            styleClass="total-label"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="3"/>

                </GridPane>

                <HBox
                        spacing="10">

                    <Button
                            text="PRINT BILL"
                            onAction="#printBill"
                            styleClass="primary-button"/>

                    <Button
                            text="CLEAR"
                            onAction="#clearFields"
                            styleClass="secondary-button"/>

                </HBox>

                <Label
                        fx:id="messageLabel"
                        text=""
                        wrapText="true"
                        styleClass="message-label"/>

            </VBox>


            <!-- RIGHT SIDE - RECEIPT -->
            <VBox
                    fx:id="billReceipt"
                    spacing="12"
                    prefWidth="350"
                    styleClass="receipt">

                <Label
                        text="SUNRISE DENTAL CLINIC"
                        styleClass="receipt-title"/>

                <Label
                        text="COLOMBO"
                        styleClass="receipt-subtitle"/>

                <Separator/>

                <Label
                        fx:id="receiptBillNumber"
                        text="Bill Number: -"/>

                <Label
                        fx:id="receiptAppointmentNumber"
                        text="Appointment Number: -"/>

                <Separator/>

                <Label
                        fx:id="receiptTreatmentCost"
                        text="Treatment Cost: Rs. 0.00"/>

                <Label
                        fx:id="receiptConsultationFee"
                        text="Consultation Fee: Rs. 0.00"/>

                <Separator/>

                <Label
                        fx:id="receiptTotalAmount"
                        text="TOTAL: Rs. 0.00"
                        styleClass="receipt-total"/>

                <Separator/>

                <Label
                        text="Thank you for choosing Sunrise Dental Clinic."
                        wrapText="true"
                        styleClass="receipt-footer"/>

            </VBox>

        </HBox>

    </center>

    <bottom>

        <HBox
                alignment="CENTER_LEFT">

            <padding>
                <Insets top="10" right="20" bottom="15" left="20"/>
            </padding>

            <Button
                    text="← BACK TO DASHBOARD"
                    onAction="#goBack"
                    styleClass="back-button"/>

        </HBox>

    </bottom>

</BorderPane>